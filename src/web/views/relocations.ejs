<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — TrendTornado</title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/relocations.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/">
        <img class="brand-logo" src="/assets/trendtornado-logo.png" alt="TrendTornado">
      </a>

      <nav class="sidebar-nav">
        <a class="nav-item" href="/"><span class="nav-icon">⌂</span>Översikt</a>
        <div class="nav-group">
          <a class="nav-item active" href="/relocations">
            <span class="nav-icon">⇄</span>Flyttare<span class="nav-chevron">⌃</span>
          </a>
          <div class="nav-subitems">
            <a class="nav-subitem <%= activeView === 'all' ? 'active' : '' %>" href="/relocations">Alla flyttare</a>
            <a class="nav-subitem <%= activeView === 'earlier' ? 'active' : '' %>" href="/relocations/earlier">Flytta tidigare</a>
            <a class="nav-subitem <%= activeView === 'later' ? 'active' : '' %>" href="/relocations/later">Flytta senare</a>
          </div>
        </div>
        <a class="nav-item" href="/analysis"><span class="nav-icon">◫</span>Analys</a>
        <a class="nav-item" href="/affinity"><span class="nav-icon">⌁</span>Affinitet</a>
        <a class="nav-item" href="/warehouse"><span class="nav-icon">♙</span>Lagerstruktur</a>
        <a class="nav-item" href="/articles"><span class="nav-icon">▣</span>Artiklar</a>
        <a class="nav-item" href="#"><span class="nav-icon">◷</span>Historik</a>
        <a class="nav-item" href="/settings"><span class="nav-icon">⚙</span>Inställningar</a>
      </nav>

      <div class="latest-analysis">
        <%- include('partials/analysis-selector') %>
      </div>
    </aside>

    <main class="main-content relocation-workspace">
      <header class="page-header relocation-header">
        <div>
          <div class="page-eyebrow">Operativ arbetsyta</div>
          <h1>Flyttare</h1>
          <p>Prioritera, granska och planera lagerflyttar från analysens rekommendationer.</p>
        </div>
        <div class="date-range"><%= period.start.toISOString().slice(0, 10) %><span>–</span><%= period.end.toISOString().slice(0, 10) %></div>
      </header>

      <nav class="relocation-workspace-tabs" aria-label="Flyttvy">
        <button class="workspace-tab active" type="button" data-workspace="candidates" aria-selected="true">Flyttkandidater</button>
        <button class="workspace-tab" type="button" data-workspace="packages" aria-selected="false">Flyttpaket <span><%= summary.packages %></span></button>
      </nav>

      <div id="candidateWorkspace" class="relocation-workspace-panel">

      <section class="relocation-summary" aria-label="Sammanfattning">
        <article class="summary-card primary-summary"><span>Flyttkandidater</span><strong><%= summary.total.toLocaleString("sv-SE") %></strong><small>gap ≥ <%= (strongGapThreshold * 100).toFixed(0) %> %</small></article>
        <article class="summary-card"><i class="summary-arrow earlier">↑</i><div><strong><%= summary.earlier.toLocaleString("sv-SE") %></strong><span>tidigare</span></div></article>
        <article class="summary-card"><i class="summary-arrow later">↓</i><div><strong><%= summary.later.toLocaleString("sv-SE") %></strong><span>senare</span></div></article>
        <article class="summary-card ergonomic-summary"><i>♙</i><div><strong><%= summary.ergonomic.toLocaleString("sv-SE") %></strong><span>ergonomiskt prioriterade</span></div></article>
        <article class="summary-card bundle-summary"><i>⌁</i><div><strong><%= summary.bundles.toLocaleString("sv-SE") %></strong><span>affinitetsbundna grupper</span></div></article>
      </section>

      <section class="relocation-filters card">
        <div class="filter-heading">
          <div><h2>Filtrera arbetslistan</h2><p>Kombinera filter för att hitta rätt flyttar.</p></div>
          <div class="filter-actions"><button id="exportRelocations" class="export-relocations" type="button">Exportera PDF</button><button id="clearFilters" class="clear-filters" type="button">Rensa filter</button></div>
        </div>
        <div class="filter-grid">
          <label>Plockzon<select id="pickZoneFilter"><option value="">Alla plockzoner</option><% filters.pickZones.forEach((zone) => { %><option value="<%= zone %>"><%= zone %></option><% }) %></select></label>
          <label>Riktning<select id="relocationDirectionFilter"><option value="">Alla riktningar</option><option value="EARLIER">Flytta tidigare</option><option value="LATER">Flytta senare</option></select></label>
          <label>Ergonomi<select id="relocationErgonomicFilter"><option value="">All ergonomi</option><option value="LOW_PREFERRED">Låg föredras</option><option value="LOW_STRONGLY_RECOMMENDED">Låg rekommenderas</option></select></label>
          <label>ABC/XYZ<select id="relocationClassificationFilter"><option value="">Alla klasser</option><% ['AX','AY','AZ','BX','BY','BZ','CX','CY','CZ'].forEach((value) => { %><option value="<%= value %>"><%= value %></option><% }) %></select></label>
          <label>Nuvarande zon<select id="currentZoneFilter"><option value="">Alla zoner</option><% filters.currentZones.forEach((zone) => { %><option value="<%= zone %>"><%= zone %></option><% }) %></select></label>
          <label>Rekommenderad zon<select id="recommendedZoneFilter"><option value="">Alla zoner</option><% filters.recommendedZones.forEach((zone) => { %><option value="<%= zone %>"><%= zone %></option><% }) %></select></label>
          <label>Minsta gap<div class="gap-filter"><input id="minimumGapFilter" type="range" min="20" max="100" value="20" step="5"><output id="minimumGapValue">20 %</output></div></label>
          <label>Minsta prioritet<select id="minimumUtilityFilter"><option value="0">Alla nivåer</option><option value="40">Medel · 40+</option><option value="65">Hög · 65+</option><option value="80">Mycket hög · 80+</option></select></label>
          <label>Sortering<select id="relocationSort"><option value="utility">Högst prioritet</option><option value="gap">Störst gap</option><option value="quantity">Högst åtgång</option><option value="article">Artikelnummer</option></select></label>
          <label class="search-filter">Sök artikel<input id="relocationSearch" type="search" placeholder="Artikelnummer eller namn..."></label>
        </div>
      </section>

      <section class="relocation-list card">
        <div class="list-heading">
          <div><h2>Arbetslista</h2><p id="relocationResultSummary"></p></div>
          <div class="list-legend"><span><i class="legend-earlier"></i>Tidigare</span><span><i class="legend-later"></i>Senare</span></div>
        </div>
        <div class="relocation-table-wrap">
          <table class="work-table">
            <thead><tr><th data-sort="utility">Prio</th><th data-sort="article">Artikel</th><th data-sort="name">Namn</th><th data-sort="classification">Klass</th><th data-sort="quantity">Åtgång/vecka</th><th data-sort="pickZone">Plockzon</th><th data-sort="current">Nu</th><th></th><th data-sort="recommended">Rekommenderat</th><th data-sort="gap">Gap</th><th data-sort="ergonomics">Ergonomi</th><th></th></tr></thead>
            <tbody>
              <% workItems.forEach((workItem) => { if (workItem.type === 'SINGLE') { const item = workItem.item; const earlier = item.direction === "EARLIER"; %>
                <tr class="work-row" tabindex="0" role="button" data-article-number="<%= item.articleNumber %>" data-name="<%= item.name.toLowerCase() %>" data-pick-zone="<%= item.pickZone %>" data-classification="<%= item.classification?.classification ?? '' %>" data-direction="<%= item.direction %>" data-ergonomic="<%= item.ergonomicRecommendation %>" data-current-zone="<%= item.currentZone %>" data-recommended-zone="<%= item.recommendedZone %>" data-gap="<%= Math.abs(item.placementGap * 100) %>" data-utility="<%= item.utility.score %>" data-quantity="<%= item.pickedQuantityPerWeek %>" data-search="<%= (item.articleNumber + ' ' + item.name).toLowerCase() %>">
                  <td><span class="utility-score"><strong><%= item.utility.score %></strong><small><%= item.utility.label %></small></span></td>
                  <td><strong><%= item.articleNumber %></strong></td>
                  <td><div class="work-name"><%= item.name %></div><% if (item.bundle) { %><small class="bundle-tag">Flytta endast som paket</small><% } %></td>
                  <td><% if (item.classification) { %><span class="badge class-<%= item.classification.abcClass.toLowerCase() %>"><%= item.classification.classification %></span><% } else { %>—<% } %></td>
                  <td><strong><%= item.pickedQuantityPerWeek.toLocaleString('sv-SE', { maximumFractionDigits: 1 }) %></strong><small>enheter/vecka</small></td>
                  <td><span class="badge zone-badge has-pick-area-color" style="--pick-area-color: <%= pickAreaColors[item.pickZone] ?? '#78827a' %>"><%= item.pickZone %></span></td>
                  <td><strong class="work-location"><%= item.currentZone %> <%= item.currentSection %></strong><small><%= (item.currentPosition * 100).toFixed(1) %> %</small><% if (item.placementEvidence?.source === 'WMS_HISTORY') { %><small class="work-placement-source">WMS-observerad</small><% } %></td>
                  <td class="work-direction <%= earlier ? 'earlier' : 'later' %>"><%= earlier ? '↑' : '↓' %></td>
                  <td><strong class="work-location"><%= item.recommendedZone %> <%= item.recommendedSection %></strong><small><%= (item.desiredPosition * 100).toFixed(1) %> %</small></td>
                  <td><span class="badge <%= earlier ? 'gap-earlier' : 'gap-later' %>"><%= earlier ? '+' : '−' %><%= Math.abs(item.placementGap * 100).toFixed(1) %> %</span></td>
                  <td><span class="ergonomic-dot <%= item.ergonomicRecommendation.toLowerCase() %>" title="<%= item.ergonomicRecommendation %>"></span><%= item.ergonomicRecommendation === 'LOW_STRONGLY_RECOMMENDED' ? 'Låg rekommenderas' : item.ergonomicRecommendation === 'LOW_PREFERRED' ? 'Låg föredras' : 'Flexibel' %></td>
                  <td class="open-arrow">›</td>
                </tr>
              <% } else { const bundle = workItem.bundle; const directions = [...new Set(bundle.members.map((member) => member.direction))]; const ergonomics = [...new Set(bundle.members.map((member) => member.ergonomicRecommendation))]; const classifications = bundle.members.map((member) => member.classification?.classification ?? '').filter(Boolean); const maxGap = Math.max(...bundle.members.map((member) => Math.abs(member.placementGap * 100))); %>
                <tr class="work-row bundle-work-row" tabindex="0" role="button" data-bundle-id="<%= bundle.id %>" data-article-number="<%= bundle.articleNumbers.join('+') %>" data-name="<%= bundle.members.map((member) => member.name).join(' ').toLowerCase() %>" data-pick-zone="<%= bundle.pickZone %>" data-classification="<%= classifications.join(' ') %>" data-direction="<%= directions.join(' ') %>" data-ergonomic="<%= ergonomics.join(' ') %>" data-current-zone="<%= [...new Set(bundle.members.map((member) => member.currentZone))].join('|') %>" data-recommended-zone="<%= [...new Set(bundle.members.map((member) => member.recommendedZone))].join('|') %>" data-gap="<%= maxGap %>" data-utility="<%= bundle.score %>" data-quantity="<%= bundle.members.reduce((sum, member) => sum + member.pickedQuantityPerWeek, 0) %>" data-search="<%= bundle.members.map((member) => member.articleNumber + ' ' + member.name).join(' ').toLowerCase() %>">
                  <td><span class="utility-score bundle-utility"><strong><%= bundle.score %></strong><small><%= bundle.label %></small><b>AFFINITET · <%= bundle.members.length %></b></span></td>
                  <td><div class="bundle-cell-stack"><% bundle.members.forEach((member) => { %><div><strong><%= member.articleNumber %></strong></div><% }) %></div></td>
                  <td><div class="bundle-cell-stack"><% bundle.members.forEach((member) => { %><div><span class="work-name"><%= member.name %></span></div><% }) %></div></td>
                  <td><div class="bundle-cell-stack"><% bundle.members.forEach((member) => { %><div><% if (member.classification) { %><span class="badge class-<%= member.classification.abcClass.toLowerCase() %>"><%= member.classification.classification %></span><% } else { %>—<% } %></div><% }) %></div></td>
                  <td><div class="bundle-cell-stack"><% bundle.members.forEach((member) => { %><div><strong><%= member.pickedQuantityPerWeek.toLocaleString('sv-SE', { maximumFractionDigits: 1 }) %></strong><small> enheter/v</small></div><% }) %></div></td>
                  <td><span class="badge zone-badge has-pick-area-color" style="--pick-area-color: <%= pickAreaColors[bundle.pickZone] ?? '#78827a' %>"><%= bundle.pickZone %></span></td>
                  <td><div class="bundle-cell-stack"><% bundle.members.forEach((member) => { %><div><strong class="work-location"><%= member.currentZone %> <%= member.currentSection %></strong><small><%= (member.currentPosition * 100).toFixed(1) %> %</small><% if (member.placementEvidence?.source === 'WMS_HISTORY') { %><small class="work-placement-source">WMS-observerad</small><% } %></div><% }) %></div></td>
                  <td><div class="bundle-cell-stack"><% bundle.members.forEach((member) => { const earlier = member.direction === 'EARLIER'; %><div class="work-direction <%= earlier ? 'earlier' : 'later' %>"><%= earlier ? '↑' : '↓' %></div><% }) %></div></td>
                  <td><div class="bundle-cell-stack"><% bundle.members.forEach((member) => { %><div><strong class="work-location"><%= member.recommendedZone %> <%= member.recommendedSection %></strong><small><%= (member.desiredPosition * 100).toFixed(1) %> %</small></div><% }) %></div></td>
                  <td><div class="bundle-cell-stack"><% bundle.members.forEach((member) => { const earlier = member.direction === 'EARLIER'; %><div><span class="badge <%= earlier ? 'gap-earlier' : 'gap-later' %>"><%= earlier ? '+' : '−' %><%= Math.abs(member.placementGap * 100).toFixed(1) %> %</span></div><% }) %></div></td>
                  <td><div class="bundle-cell-stack"><% bundle.members.forEach((member) => { %><div><span class="ergonomic-dot <%= member.ergonomicRecommendation.toLowerCase() %>"></span><%= member.ergonomicRecommendation === 'LOW_STRONGLY_RECOMMENDED' ? 'Låg rekommenderas' : member.ergonomicRecommendation === 'LOW_PREFERRED' ? 'Låg föredras' : 'Flexibel' %></div><% }) %></div></td>
                  <td class="open-arrow">›</td>
                </tr>
              <% } }) %>
            </tbody>
          </table>
        </div>
        <div class="work-pagination"><span id="workPageSummary"></span><div><button id="workPreviousPage" type="button">‹</button><span id="workPageIndicator"></span><button id="workNextPage" type="button">›</button></div></div>
      </section>
      </div>

      <div id="packageWorkspace" class="relocation-workspace-panel" hidden>
        <% const packageZones = [...new Set(relocationPackages.map((item) => item.pickZone))]; %>
        <section class="package-intro card">
          <div>
            <span class="package-eyebrow">Exakta och ordnade flyttkedjor</span>
            <h2>Flyttpaket</h2>
            <p>Ett paket består av en eller flera konfliktfria kedjor. Varje kedja börjar med en ledig plats och fortsätter genom att återanvända platsen som föregående flytt frigör. Litet, standard och stort är alternativa omfattningar – välj ett paket per plockområde.</p>
          </div>
          <div class="package-intro-stats"><strong><%= relocationPackages.length.toLocaleString('sv-SE') %></strong><span>paket i analysen</span></div>
        </section>

        <section class="package-controls card">
          <div>
            <span>Plockområde</span>
            <div class="package-filter-buttons" id="packageZoneFilters">
              <button class="active" type="button" data-package-zone="">Alla</button>
              <% packageZones.forEach((zone) => { %><button type="button" data-package-zone="<%= zone %>" style="--pick-area-color:<%= pickAreaColors[zone] ?? '#78827a' %>"><%= zone %></button><% }) %>
            </div>
          </div>
          <div>
            <span>Paketstorlek</span>
            <div class="package-filter-buttons" id="packageSizeFilters">
              <button class="active" type="button" data-package-size="">Alla</button>
              <button type="button" data-package-size="SMALL">Litet · upp till 5</button>
              <button type="button" data-package-size="STANDARD">Standard · upp till 10</button>
              <button type="button" data-package-size="LARGE">Stort · upp till 20</button>
            </div>
          </div>
        </section>

        <p id="packageResultSummary" class="package-result-summary"></p>
        <section class="package-grid">
          <% relocationPackages.forEach((packagePlan) => { %>
            <article class="relocation-package-card card" data-package-zone="<%= packagePlan.pickZone %>" data-package-size="<%= packagePlan.size %>">
              <header>
                <div>
                  <span class="badge zone-badge has-pick-area-color" style="--pick-area-color:<%= pickAreaColors[packagePlan.pickZone] ?? '#78827a' %>"><%= packagePlan.pickZone %></span>
                  <small><%= packagePlan.sizeLabel %> paket</small>
                  <h3><%= packagePlan.steps.length %> flyttar i genomförbar ordning</h3>
                </div>
                <div class="package-score"><strong><%= (packagePlan.objectiveGain * 100).toFixed(2).replace('.', ',') %></strong><span>balanserad effekt</span></div>
              </header>
              <div class="package-route-summary">
                <div><span>Start</span><strong><%= packagePlan.chainCount %> flyttkedj<%= packagePlan.chainCount === 1 ? 'a' : 'or' %></strong><small><%= packagePlan.startLocationCodes.length %> ledig<%= packagePlan.startLocationCodes.length === 1 ? '' : 'a' %> startplats<%= packagePlan.startLocationCodes.length === 1 ? '' : 'er' %></small></div>
                <i>→</i>
                <div><span>Efter genomförande</span><strong><%= packagePlan.finalFreeLocationCodes.length %> ledig<%= packagePlan.finalFreeLocationCodes.length === 1 ? '' : 'a' %> plats<%= packagePlan.finalFreeLocationCodes.length === 1 ? '' : 'er' %></strong><small>sista: <%= packagePlan.finalFreeLocationCode %></small></div>
                <div><span>Flerplocksspann</span><strong>+<%= (packagePlan.spanImprovement * 100).toFixed(2) %> p.e.</strong></div>
                <div><span>Viktordning</span><strong>+<%= (packagePlan.weightOrderImprovement * 100).toFixed(2) %> p.e.</strong></div>
              </div>
              <details>
                <summary>Visa flyttordning</summary>
                <div class="package-step-table-wrap">
                  <table class="package-step-table">
                    <thead><tr><th>Steg</th><th>Artikel</th><th>Från</th><th>Till</th><th>Åtgärd</th><th>Kapacitet</th></tr></thead>
                    <tbody>
                      <% packagePlan.steps.forEach((step) => { %>
                        <tr>
                          <td><b><%= step.step %></b></td>
                          <td><strong><%= step.articleNumber %></strong><small><%= step.name %></small></td>
                          <td><%= step.fromLocationCode %></td>
                          <td><%= step.toLocationCode %></td>
                          <td><%= step.actionType === 'EMPTY_LOCATION' ? `Starta kedja ${step.chainNumber} i ledig plats` : `Fortsätt kedja ${step.chainNumber} i frigjord plats` %></td>
                          <td><% if (step.capacity.estimatedDaysOfDemand !== null) { %><strong><%= step.capacity.estimatedDaysOfDemand.toLocaleString('sv-SE', { maximumFractionDigits: 1 }) %> dagar</strong><small><%= step.capacity.estimatedCapacity.toLocaleString('sv-SE') %> <%= step.capacity.baseUnit ?? 'enheter' %></small><% } else { %>Ej bedömd<% } %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
                <p class="package-guardrail">Varje steg är geometriskt kontrollerat och får inte försämra flerplocksspann eller viktordning. Kontrollera aktuellt saldo och att platsen fortfarande är ledig före genomförande.</p>
              </details>
              <footer>
                <span>Flyttarna måste utföras i angiven ordning.</span>
                <button class="export-package" type="button" data-package-id="<%= packagePlan.id %>">Exportera paket till PDF</button>
              </footer>
            </article>
          <% }) %>
        </section>
        <% if (relocationPackages.length === 0) { %>
          <section class="package-empty card"><h3>Inga flyttkedjor i den aktiva analysen</h3><p>Skapa en ny analys med algoritmversion 1.8. Paket kräver artikelmått, platsmått och minst en lämplig ledig startplats.</p></section>
        <% } %>
      </div>
    </main>
  </div>

  <div id="drawerBackdrop" class="drawer-backdrop" hidden></div>
  <aside id="relocationDrawer" class="relocation-drawer" aria-hidden="true" aria-labelledby="drawerTitle">
    <button id="closeDrawer" class="drawer-close" type="button" aria-label="Stäng">×</button>
    <div id="drawerContent"></div>
  </aside>

  <form id="relocationExportForm" method="post" action="/relocations/export.pdf" hidden><input id="exportArticleNumbers" name="articleNumbers" type="hidden"></form>
  <form id="packageExportForm" method="post" action="/relocations/packages/export.pdf" hidden><input id="exportPackageId" name="packageId" type="hidden"></form>

  <script id="relocationData" type="application/json"><%- JSON.stringify(drawerRecommendations).replace(/</g, "\\u003c") %></script>
  <script id="bundleData" type="application/json"><%- JSON.stringify(drawerBundles).replace(/</g, "\\u003c") %></script>
  <script src="/js/relocations.js"></script>
</body>
</html>
