<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inställningar — TrendTornado</title>
  <link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/settings.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/" aria-label="TrendTornado – översikt"><img class="brand-logo" src="/assets/trendtornado-logo.png" alt="TrendTornado"></a>
      <nav class="sidebar-nav">
        <a class="nav-item" href="/"><span class="nav-icon">⌂</span>Översikt</a>
        <div class="nav-group"><a class="nav-item" href="/relocations"><span class="nav-icon">⇄</span>Flyttare<span class="nav-chevron">⌃</span></a><div class="nav-subitems"><a class="nav-subitem" href="/relocations">Alla flyttare</a><a class="nav-subitem" href="/relocations/earlier">Flytta tidigare</a><a class="nav-subitem" href="/relocations/later">Flytta senare</a></div></div>
        <a class="nav-item" href="/analysis"><span class="nav-icon">◫</span>Analys</a><a class="nav-item" href="/affinity"><span class="nav-icon">⌁</span>Affinitet</a><a class="nav-item" href="/warehouse"><span class="nav-icon">♙</span>Lagerstruktur</a><a class="nav-item" href="/articles"><span class="nav-icon">▣</span>Artiklar</a><a class="nav-item" href="#"><span class="nav-icon">◷</span>Historik</a><a class="nav-item active" href="/settings"><span class="nav-icon">⚙</span>Inställningar</a>
      </nav>
      <div class="latest-analysis"><%- include('partials/analysis-selector') %></div>
    </aside>

    <main class="main-content settings-workspace">
      <header class="page-header settings-header"><div><div class="page-eyebrow">Modellens regler</div><h1>Inställningar</h1><p>De få värden som styr hur TrendTornado analyserar och rekommenderar.</p></div></header>
      <% if (saved) { %><div class="settings-message success">✓ Inställningarna är sparade och används när nästa analys skapas.</div><% } %>
      <% if (error) { %><div class="settings-message error"><strong>Inställningarna kunde inte sparas.</strong><span><%= error %></span></div><% } %>
      <% if (analysisCreated) { %><div class="settings-message success">✓ Analysen skapades. Den finns nu i analysväljaren.</div><% } %>
      <% if (analysisError) { %><div class="settings-message error"><strong>Analysen kunde inte skapas.</strong><span><%= analysisError %></span></div><% } %>
      <% if (dataImported) { %><div class="settings-message success">✓ Datakällan importerades och är tillgänglig för nästa analys.</div><% } %>
      <% if (dataSourceChanged) { %><div class="settings-message success">✓ Datakällan inaktiverades. Sparade analyser påverkas inte.</div><% } %>
      <% if (dataSourceDeleted) { %><div class="settings-message success">✓ Datakällan och den uppladdade filen togs bort permanent. Sparade analyser påverkas inte.</div><% } %>
      <% if (zonesSaved) { %><div class="settings-message success">✓ Lagerreglerna sparades och används när nästa analys skapas.</div><% } %>
      <% if (pickAreasSaved) { %><div class="settings-message success">✓ Plockområden och färger sparades.</div><% } %>
      <% if (articleRulesSaved) { %><div class="settings-message success">✓ Artikelundantagen sparades och används när nästa analys skapas.</div><% } %>
      <% if (analysisDeleted) { %><div class="settings-message success">✓ Analysen togs bort.</div><% } %>
      <% if (importError) { %><div class="settings-message error"><strong>Ändringen kunde inte genomföras.</strong><span><%= importError %></span></div><% } %>

      <section id="analyses" class="settings-section card analysis-management">
        <div class="settings-section-intro"><span>ANALYSER</span><h2>Analyskörningar</h2><p>Skapa ett fryst analysögonblick. Alla sidor läser därefter den analys som markerats som aktiv.</p></div>
        <div class="analysis-management-content">
          <form class="new-analysis-form" method="post" action="/settings/analyses">
            <div class="analysis-form-heading"><div><strong>Ny analys</strong><p>Den nuvarande aktiva analysen används tills den nya är färdig och aktiveras.</p></div></div>
            <div class="analysis-form-grid">
              <label><span>Namn</span><input name="name" type="text" maxlength="80" placeholder="Exempelvis Helår 2025" required></label>
              <label><span>Från</span><input name="periodStart" type="date" min="<%= periodStart?.toISOString().slice(0,10) %>" max="<%= periodEnd?.toISOString().slice(0,10) %>" value="<%= periodStart?.toISOString().slice(0,10) %>" required></label>
              <label><span>Till</span><input name="periodEnd" type="date" min="<%= periodStart?.toISOString().slice(0,10) %>" max="<%= periodEnd?.toISOString().slice(0,10) %>" value="<%= periodEnd?.toISOString().slice(0,10) %>" required></label>
            </div>
            <label class="activate-created"><input name="activate" type="checkbox" value="1"><span>Aktivera automatiskt när analysen lyckas</span></label>
            <button class="create-analysis-button" type="submit">Starta analys</button>
          </form>
          <div class="analysis-run-list">
            <div class="analysis-run-heading"><strong>Tidigare analyser</strong><span><%= analysisRuns.length %> sparade</span></div>
            <% analysisRuns.forEach((run) => { %>
              <article class="analysis-run <%= run.isActive ? 'is-active' : '' %>">
                <div><strong><%= run.name %></strong><span><%= run.periodStart %> – <%= run.periodEnd %> · <%= run.inputRows.toLocaleString('sv-SE') %> rader</span><small>Skapad <%= new Date(run.createdAt).toLocaleString('sv-SE', { dateStyle: 'short', timeStyle: 'short' }) %> · motor <%= run.algorithmVersion %></small></div>
                <span class="run-status <%= run.status.toLowerCase() %>"><%= run.isActive ? 'AKTIV' : run.status === 'COMPLETED' ? 'KLAR' : run.status %></span>
                <% if (!run.isActive) { %><div class="analysis-run-actions"><% if (run.status === 'COMPLETED') { %><form method="post" action="/analyses/activate"><input type="hidden" name="analysisId" value="<%= run.id %>"><input type="hidden" name="returnTo" value="/settings#analyses"><button type="submit">Aktivera</button></form><% } %><form method="post" action="/analyses/delete" onsubmit="return confirm('Ta bort den här analysen? Detta kan inte ångras.')"><input type="hidden" name="analysisId" value="<%= run.id %>"><button class="delete-analysis" type="submit">Ta bort</button></form></div><% } %>
              </article>
            <% }) %>
          </div>
        </div>
      </section>

      <form id="settingsForm" method="post" action="/settings">
        <section class="settings-section card">
          <div class="settings-section-intro"><span>01</span><h2>Analys</h2><p>Reglerna som avgör vilka artiklar som prioriteras och när en avvikelse blir en flyttkandidat.</p></div>
          <div class="settings-fields">
            <label class="setting-field"><div><strong>Flyttgräns</strong><p>Artiklar med ett absolut placement gap över denna nivå visas som flyttkandidater.</p></div><div class="number-input"><input name="movementThreshold" type="number" min="0" max="100" step="1" required value="<%= settings.analysis.movementThreshold * 100 %>"><span>%</span></div></label>
            <div class="priority-settings"><div class="priority-heading"><div><strong>Prioritering</strong><p>Vikterna måste tillsammans bli 100 %.</p></div><output id="weightTotal">100 %</output></div><div class="priority-inputs"><label><span>Plockfrekvens</span><div class="number-input"><input id="frequencyWeight" name="frequencyWeight" type="number" min="0" max="100" step="1" required value="<%= settings.analysis.frequencyWeight * 100 %>"><span>%</span></div></label><label><span>Hanterad vikt</span><div class="number-input"><input id="handlingWeight" name="handlingWeight" type="number" min="0" max="100" step="1" required value="<%= settings.analysis.handlingWeight * 100 %>"><span>%</span></div></label></div></div>
          </div>
        </section>

        <section class="settings-section card">
          <div class="settings-section-intro"><span>02</span><h2>ABC/XYZ</h2><p>ABC-gränserna anger hur stor kumulativ andel av alla plockstopp som utgör hög respektive medelhög aktivitet.</p></div>
          <div class="settings-fields"><label class="setting-field"><div><strong>A-klass till</strong><p>Artiklar som tillsammans står för den första delen av aktiviteten.</p></div><div class="number-input"><input name="abcAThreshold" type="number" min="1" max="98" step="1" required value="<%= settings.classification.abcAThreshold * 100 %>"><span>%</span></div></label><label class="setting-field"><div><strong>A + B till</strong><p>Resterande artiklar blir C-klass. Värdet måste vara högre än A-gränsen.</p></div><div class="number-input"><input name="abcBThreshold" type="number" min="2" max="99" step="1" required value="<%= settings.classification.abcBThreshold * 100 %>"><span>%</span></div></label><div class="coming-setting"><div><strong>XYZ-regler</strong><p>X och Y använder tills vidare de dokumenterade standardgränserna för aktiva veckor och variationskoefficient.</p></div><span>Standardmodell</span></div></div>
        </section>

        <section class="settings-section card">
          <div class="settings-section-intro"><span>03</span><h2>Ergonomi</h2><p>Gränserna gäller både artikelns styckvikt och den genomsnittliga hanterade vikten per plock.</p></div>
          <div class="settings-fields"><label class="setting-field"><div><strong>Låg placering föredras från</strong><p>Artikeln markeras som ergonomiskt prioriterad.</p></div><div class="number-input"><input name="lowPreferredKg" type="number" min="0" step="0.1" required value="<%= settings.ergonomics.lowPreferredKg %>"><span>kg</span></div></label><label class="setting-field"><div><strong>Låg placering rekommenderas starkt från</strong><p>Måste vara lika med eller högre än gränsen ovan.</p></div><div class="number-input"><input name="lowStronglyRecommendedKg" type="number" min="0" step="0.1" required value="<%= settings.ergonomics.lowStronglyRecommendedKg %>"><span>kg</span></div></label></div>
        </section>

        <section class="settings-section card">
          <div class="settings-section-intro"><span>04</span><h2>Avståndsmodell</h2><p>Standardmåttet används för att uppskatta gångavstånd mellan fack i samma plockflöde.</p></div>
          <div class="settings-fields"><label class="setting-field featured-setting"><div><strong>Standardfackets bredd</strong><p>Avstånd från ett facks start till nästa facks start. Kan senare skrivas över per zon.</p></div><div class="number-input"><input name="standardBayWidthMeters" type="number" min="0.1" max="20" step="0.1" required value="<%= settings.distance.standardBayWidthMeters %>"><span>meter</span></div></label><label class="setting-field"><div><strong>Balkhöjd mellan hyllor</strong><p>Läggs till mellan varje hyllnivå när höjden över golvet beräknas.</p></div><div class="number-input"><input name="beamThicknessCm" type="number" min="0" max="50" step="0.5" required value="<%= settings.distance.beamThicknessCm %>"><span>cm</span></div></label><div class="coming-setting"><div><strong>Zonövergångar</strong><p>Manuella avstånd mellan angränsande zoner läggs till när distansmotorn byggs.</p></div><span>Kommer härnäst</span></div></div>
        </section>

        <div class="settings-savebar"><div><strong>Spara modellregler</strong><span>Ändringarna används när nästa analys skapas. Befintliga analyser ändras inte.</span></div><button id="saveSettings" type="submit">Spara inställningar</button></div>
      </form>

      <section id="article-rules" class="settings-section card">
        <div class="settings-section-intro"><span>05</span><h2>Artikelundantag</h2><p>Styr artiklar som inte ska påverka analysen eller inte ska visas som flyttkandidater. Reglerna används när nästa analys skapas.</p></div>
        <form class="article-rule-form" method="post" action="/settings/article-rules">
          <div id="articleRuleRows" class="article-rule-rows">
            <% settings.articleRules.forEach((rule) => { const mode = rule.excludeFromAnalysis && rule.hideRelocation ? 'BOTH' : rule.excludeFromAnalysis ? 'ANALYSIS' : 'RELOCATION'; %>
              <div class="article-rule-row"><input name="articleNumber" type="text" value="<%= rule.articleNumber %>" placeholder="Artikelnummer" required><select name="ruleMode"><option value="ANALYSIS" <%= mode === 'ANALYSIS' ? 'selected' : '' %>>Exkludera från analys och statistik</option><option value="RELOCATION" <%= mode === 'RELOCATION' ? 'selected' : '' %>>Dölj endast som flyttkandidat</option><option value="BOTH" <%= mode === 'BOTH' ? 'selected' : '' %>>Båda</option></select><button class="remove-article-rule" type="button" aria-label="Ta bort artikelundantag">×</button></div>
            <% }) %>
          </div>
          <div class="article-rule-actions"><button id="addArticleRule" class="secondary-setting-button" type="button">Lägg till artikel</button><button type="submit">Spara artikelundantag</button></div>
        </form>
      </section>

      <section id="pick-areas" class="settings-section card">
        <div class="settings-section-intro"><span>05</span><h2>Plockområden</h2><p>Definiera lagerdelarnas namn och färg en gång. Lagerzonerna väljer sedan bland dessa områden.</p></div>
        <form class="pick-area-form" method="post" action="/settings/pick-areas">
          <div id="pickAreaRows" class="pick-area-rows"><% settings.warehouse.pickAreas.forEach((area) => { %><div class="pick-area-row"><input type="hidden" name="originalName" value="<%= area.name %>"><input name="pickAreaName" type="text" value="<%= area.name %>" maxlength="40" required><input name="pickAreaColor" type="color" value="<%= area.color %>" aria-label="Färg för <%= area.name %>"><button class="remove-pick-area" type="button" aria-label="Ta bort plockområde">×</button></div><% }) %></div>
          <div class="pick-area-actions"><button id="addPickArea" class="secondary-setting-button" type="button">Lägg till område</button><button type="submit">Spara plockområden</button></div>
        </form>
      </section>

      <section id="warehouse-rules" class="settings-section card">
        <div class="settings-section-intro"><span>06</span><h2>Lagerregler</h2><p>Zonerna upptäcks i den aktiva lagerstrukturfilen. Välj temperatur och plockområde innan nästa analys skapas.</p></div>
        <form class="zone-mapping-form" method="post" action="/settings/zones">
          <details class="collapsible-settings"><summary><span>Visa <%= zoneProfiles.length %> lagerzoner</span><small><%= zoneProfiles.filter((profile) => !profile.configured).length %> omappade</small></summary><div class="settings-table-wrap"><table class="settings-table zone-mapping-table"><thead><tr><th>Fysisk zon</th><th>Underlagets område</th><th>Platser</th><th>Temperatur</th><th>Plockområde</th></tr></thead><tbody><% zoneProfiles.forEach((profile) => { %><tr class="<%= profile.configured ? '' : 'unconfigured-zone' %>"><td><strong><%= profile.physicalZone %></strong><input type="hidden" name="physicalZone" value="<%= profile.physicalZone %>"></td><td><span><%= profile.sourceAreas.join(', ') || 'Saknas' %></span><small><%= profile.sourceSubAreas.join(', ') %></small></td><td><%= profile.locationCount.toLocaleString('sv-SE') %></td><td><select name="temperatureZone"><% [['KOL','KOL'],['KYL','KYLD'],['FRY','FRYST']].forEach(([value, label]) => { %><option value="<%= value %>" <%= profile.temperatureZone === value ? 'selected' : '' %>><%= label %></option><% }) %></select></td><td><select name="pickZoneType"><% settings.warehouse.pickAreas.forEach((area) => { %><option value="<%= area.name %>" <%= profile.pickZoneType === area.name ? 'selected' : '' %>><%= area.name %></option><% }) %></select></td></tr><% }) %></tbody></table></div></details>
          <div class="zone-save"><span><%= zoneProfiles.filter((profile) => !profile.configured).length %> nya eller omappade zoner</span><button type="submit">Spara lagerregler</button></div>
        </form>
      </section>

      <section id="data-sources" class="settings-section card data-sources-section">
        <div class="settings-section-intro"><span>07</span><h2>Datakällor</h2><p>Historik läggs till. Artikeldata, lagerstruktur och artikelplacering versionsersätts utan att äldre analyser förändras.</p></div>
        <div class="source-management">
          <% const sourceCards = [
            { type: sourceTypes.HISTORY, title: 'Transaktionshistorik', description: 'Alla aktiva historikfiler kombineras.', effective: false },
            { type: sourceTypes.ARTICLES, title: 'Artikeldata', description: 'Ny fil blir aktiv artikelversion.', effective: false },
            { type: sourceTypes.LOCATIONS, title: 'Lagerstruktur', description: 'Ny fil blir aktiv strukturversion.', effective: false },
            { type: sourceTypes.PLACEMENTS, title: 'Artikelplacering', description: 'Ögonblicksbild av aktuella placeringar.', effective: true },
          ]; %>
          <% sourceCards.forEach((card) => { const matchingSources = dataSources.filter((source) => source.type === card.type); %>
            <article class="source-card">
              <div class="source-card-heading"><div><strong><%= card.title %></strong><p><%= card.description %></p></div><span><%= matchingSources.filter((source) => source.status === 'ACTIVE').length %> aktiva</span></div>
              <div class="source-upload" data-source-type="<%= card.type %>"><input class="source-file" type="file" accept=".csv,text/csv"><% if (card.effective) { %><input class="source-effective-date" type="date" value="<%= new Date().toISOString().slice(0,10) %>" aria-label="Gäller från"><% } %><button class="source-upload-button" type="button">Importera CSV</button><small class="source-upload-status"></small></div>
              <details class="source-version-details"><summary>Visa <%= matchingSources.length %> fil<%= matchingSources.length === 1 ? '' : 'er' %></summary><div class="source-version-list">
                <% matchingSources.forEach((source) => { %><div class="source-version"><span class="source-state <%= source.status.toLowerCase() %>"><%= source.status === 'ACTIVE' ? 'AKTIV' : source.status === 'SUPERSEDED' ? 'TIDIGARE' : 'INAKTIV' %></span><div><strong><%= source.originalFilename %></strong><small><%= source.rowCount ? source.rowCount.toLocaleString('sv-SE') + ' rader · ' : '' %>Importerad <%= new Date(source.importedAt).toLocaleString('sv-SE', { dateStyle:'short', timeStyle:'short' }) %><% if (source.periodStart) { %> · <%= source.periodStart %>–<%= source.periodEnd %><% } %></small><% if (source.validation.overlappingDocuments) { %><em><%= source.validation.overlappingDocuments.toLocaleString('sv-SE') %> överlappande dokument · <%= source.validation.overlappingRows.toLocaleString('sv-SE') %> rader ignoreras vid analys</em><% } %><% if (source.validation.placementFormat) { %><em><%= source.validation.placementFormat === 'WMS_ITEM_PLACING_LOC' ? 'Direkt WMS-export' : 'Konverterad CSV' %> · <%= (source.validation.validRows ?? source.rowCount ?? 0).toLocaleString('sv-SE') %> giltiga placeringar<% if (source.validation.ignoredRows) { %> · <%= source.validation.ignoredRows.toLocaleString('sv-SE') %> rader ignorerade<% } %></em><% } %></div><div class="source-version-actions"><% if (source.type === sourceTypes.HISTORY && source.status === 'ACTIVE') { %><form method="post" action="/settings/data-sources/deactivate"><input type="hidden" name="sourceId" value="<%= source.id %>"><button type="submit">Inaktivera</button></form><% } else if (source.status !== 'ACTIVE') { %><form method="post" action="/settings/data-sources/activate"><input type="hidden" name="sourceId" value="<%= source.id %>"><button type="submit">Aktivera</button></form><% } %><% if (source.isManaged && (source.type === sourceTypes.HISTORY || source.status !== 'ACTIVE')) { %><form method="post" action="/settings/data-sources/delete" onsubmit="return confirm('Ta bort filen permanent? Sparade analyser påverkas inte, men filen kan inte återställas.')"><input type="hidden" name="sourceId" value="<%= source.id %>"><button class="delete-source" type="submit">Ta bort permanent</button></form><% } %></div></div><% }) %>
              </div></details>
            </article>
          <% }) %>
        </div>
      </section>
    </main>
  </div>
  <script src="/js/settings.js"></script>
</body>
</html>
