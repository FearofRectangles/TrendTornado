<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article.articleNumber %> — TrendTornado</title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/articles.css">
</head>
<body>
  <% const value = (input, suffix = '') => input === null || input === undefined ? 'Saknas' : input.toLocaleString('sv-SE', { maximumFractionDigits: 2 }) + suffix; %>
  <% const percent = (input) => input === null ? 'Ej beräknad' : (input * 100).toLocaleString('sv-SE', { maximumFractionDigits: 1 }) + ' %'; %>
  <% const recommendation = article.priorityScore === null ? 'UNDERLAG SAKNAS' : !article.isRelocationCandidate ? 'BEHÅLL PLACERING' : article.direction === 'EARLIER' ? 'FLYTTA TIDIGARE' : 'FLYTTA SENARE'; %>
  <% const ergonomicLabel = article.ergonomicRecommendation === 'LOW_STRONGLY_RECOMMENDED' ? 'LÅG STARKT REKOMMENDERAD' : article.ergonomicRecommendation === 'LOW_PREFERRED' ? 'LÅG FÖREDRAS' : article.ergonomicRecommendation ? 'FLEXIBEL PLACERING' : 'EJ BERÄKNAD'; %>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/"><div class="brand-mark">◉</div><div><div class="brand-name">Trend<span>Tornado</span></div><div class="brand-subtitle">lite hit och lite dit</div></div></a>
      <nav class="sidebar-nav">
        <a class="nav-item" href="/"><span class="nav-icon">⌂</span>Översikt</a>
        <div class="nav-group"><a class="nav-item" href="/relocations"><span class="nav-icon">⇄</span>Flyttare<span class="nav-chevron">⌃</span></a><div class="nav-subitems"><a class="nav-subitem" href="/relocations">Alla flyttare</a><a class="nav-subitem" href="/relocations/earlier">Flytta tidigare</a><a class="nav-subitem" href="/relocations/later">Flytta senare</a></div></div>
        <a class="nav-item" href="/analysis"><span class="nav-icon">◫</span>Analys</a><a class="nav-item" href="/affinity"><span class="nav-icon">⌁</span>Affinitet</a><a class="nav-item" href="/warehouse"><span class="nav-icon">♙</span>Lagerstruktur</a><a class="nav-item active" href="/articles"><span class="nav-icon">▣</span>Artiklar</a><a class="nav-item" href="#"><span class="nav-icon">◷</span>Historik</a><a class="nav-item" href="/settings"><span class="nav-icon">⚙</span>Inställningar</a>
      </nav>
      <div class="latest-analysis"><%- include('partials/analysis-selector') %></div>
    </aside>

    <main class="main-content article-detail-workspace">
      <a class="back-link" href="/articles">← Tillbaka till artikelregistret</a>
      <header class="article-identity">
        <div><div class="article-number-label">Artikel <%= article.articleNumber %></div><h1><%= article.name %></h1><span class="article-category"><%= article.category ?? article.pickZone ?? 'OKATEGORISERAD' %></span></div>
        <% if (article.isRelocationCandidate) { %><a class="candidate-link" href="/relocations">Visa i Flyttare ↗</a><% } %>
      </header>

      <div class="article-detail-grid">
        <section class="detail-card card classification-card">
          <div class="detail-card-heading"><span>ABC/XYZ-klassificering</span><i>◆</i></div>
          <% if (article.classification) { const c = article.classification; %>
            <div class="classification-hero"><strong class="classification-badge class-<%= c.abcClass.toLowerCase() %>"><%= c.classification %></strong><div><b><%= c.abcClass === 'A' ? 'Hög aktivitet' : c.abcClass === 'B' ? 'Medelaktivitet' : 'Låg aktivitet' %></b><span><%= c.xyzClass === 'X' ? 'Stabil efterfrågan' : c.xyzClass === 'Y' ? 'Varierande efterfrågan' : c.xyzClass === 'Z' ? 'Sporadisk efterfrågan' : 'Otillräcklig historik' %></span></div></div>
            <dl><div><dt>Aktiva veckor</dt><dd><%= c.xyz.activeWeeks %> av <%= c.xyz.observedWeeks %></dd></div><div><dt>Snitt per vecka</dt><dd><%= c.xyz.meanWeeklyPickStops.toLocaleString('sv-SE', { maximumFractionDigits: 1 }) %> stopp</dd></div><div><dt>Variationskoefficient</dt><dd><%= c.xyz.coefficientOfVariation === null ? '—' : c.xyz.coefficientOfVariation.toLocaleString('sv-SE', { maximumFractionDigits: 2 }) %></dd></div><div><dt>Underlag</dt><dd><%= c.quality === 'STRONG' ? 'Starkt' : c.quality === 'RELIABLE' ? 'Tillförlitligt' : c.quality === 'PRELIMINARY' ? 'Preliminärt' : 'Otillräckligt' %></dd></div></dl>
          <% } else { %><div class="affinity-empty">Artikeln saknar plockhistorik och kan inte klassificeras.</div><% } %>
        </section>
        <section class="detail-card card master-card"><div class="detail-card-heading"><span>Masterdata</span><i>▣</i></div><dl><div><dt>Vikt</dt><dd><%= value(article.weightKg, ' kg') %></dd></div><div><dt>Temperatur</dt><dd><%= article.temperatureZone ?? 'Saknas' %></dd></div><div><dt>Produktgrupp</dt><dd class="<%= article.category ? '' : 'missing-value' %>"><%= article.category ?? 'Saknas i källdatan' %></dd></div><div><dt>Basenhet</dt><dd><%= article.baseUnit ?? 'Saknas' %></dd></div><div><dt>Artikelmått H × B × D</dt><dd><%= [article.articleHeightCm, article.articleWidthCm, article.articleDepthCm].every((item) => item !== null) ? `${value(article.articleHeightCm)} × ${value(article.articleWidthCm)} × ${value(article.articleDepthCm)} cm` : 'Saknas' %></dd></div></dl></section>

        <section class="detail-card card placement-card"><div class="detail-card-heading"><span>Placering</span><i>⌖</i></div><dl><div><dt>Nuvarande plats</dt><dd><%= article.currentLocation ?? 'Ingen plockplats' %></dd></div><div><dt>Plockzon</dt><dd><%= article.pickZone ?? 'Saknas' %></dd></div><div><dt>Position</dt><dd><%= percent(article.currentPosition) %></dd></div><div><dt>Sektion</dt><dd><%= article.currentSection ?? 'Saknas' %></dd></div><div><dt>Höjd över golv</dt><dd><%= article.currentFloorHeightCm === null ? 'Saknas' : value(article.currentFloorHeightCm, ' cm') %></dd></div><div><dt>Platsmått H × B × D</dt><dd><%= [article.locationHeightCm, article.locationWidthCm, article.locationDepthCm].every((item) => item !== null) ? `${value(article.locationHeightCm)} × ${value(article.locationWidthCm)} × ${value(article.locationDepthCm)} cm` : 'Saknas' %></dd></div><div><dt>Platsvolym</dt><dd><%= article.locationVolumeM3 === null ? 'Saknas' : value(article.locationVolumeM3, ' m³') %></dd></div></dl></section>

        <section class="detail-card card history-card"><div class="detail-card-heading"><span>Plockhistorik</span><i>◷</i></div><dl><div><dt>Plock</dt><dd><%= article.pickFrequency.toLocaleString('sv-SE') %></dd></div><div><dt>Plockad kvantitet</dt><dd><%= article.pickedQuantity.toLocaleString('sv-SE') %></dd></div><div><dt>Åtgång per vecka</dt><dd><%= article.pickedQuantityPerWeek.toLocaleString('sv-SE', { maximumFractionDigits: 1 }) %></dd></div><div><dt>Snitt/plock</dt><dd><%= value(article.averageQuantityPerPick) %></dd></div><div><dt>Hanterad vikt/plock</dt><dd><%= value(article.averageHandledWeightPerPick, ' kg') %></dd></div></dl><p class="history-period-note">Genomsnitt över <%= article.observedWeekCount %> observerade veckor, inklusive veckor utan plock.</p></section>

        <section class="detail-card card tornado-card">
          <div class="detail-card-heading"><span>Trend Tornado</span><i>◉</i></div>
          <div class="tornado-score"><span>Prioritet</span><strong><%= article.priorityScore === null ? '—' : article.priorityScore.toFixed(2).replace('.', ',') %></strong><div><i style="width:<%= (article.priorityScore ?? 0) * 100 %>%"></i></div></div>
          <dl><div><dt>Önskad position</dt><dd><%= percent(article.desiredPosition) %></dd></div><div><dt>Placement gap</dt><dd class="gap-value <%= article.direction === 'EARLIER' ? 'earlier' : 'later' %>"><%= article.placementGap === null ? 'Ej beräknad' : (article.placementGap >= 0 ? '+' : '−') + percent(Math.abs(article.placementGap)) %></dd></div></dl>
          <div class="recommendation-block"><span>Rekommendation</span><strong class="<%= article.direction === 'EARLIER' ? 'earlier' : 'later' %>"><%= recommendation %></strong><% if (article.recommendedZone) { %><small>Målområde: <%= article.recommendedZone %> · <%= article.recommendedSection %></small><% } %></div>
          <div class="ergonomic-block"><span>Ergonomi</span><strong><%= ergonomicLabel %></strong><% if (article.ergonomicReason) { %><small><%= article.ergonomicReason %></small><% } %></div>
        </section>

        <section class="detail-card card affinity-card">
          <div class="detail-card-heading"><span>Pick affinity</span><i>⌁</i></div>

          <div class="affinity-intro">
            <div>
              <h2>Ofta plockad tillsammans med</h2>
              <p>Andel av artikelns <strong><%= affinity.selectedOrderCount.toLocaleString('sv-SE') %></strong> order där partnerartikeln också förekommer.</p>
            </div>
            <span>Minst <%= affinity.minimumCommonOrders %> gemensamma order</span>
          </div>

          <% if (affinity.partners.length > 0) { %>
            <div class="affinity-list">
              <% affinity.partners.forEach((partner, index) => { %>
                <% if (partner.available) { %>
                  <a class="affinity-row" href="/articles/<%= encodeURIComponent(partner.articleNumber) %>">
                <% } else { %>
                  <div class="affinity-row unavailable">
                <% } %>
                  <span class="affinity-rank"><%= index + 1 %></span>
                  <div class="affinity-article">
                    <strong><%= partner.articleNumber %></strong>
                    <span><%= partner.name %></span>
                    <% if (partner.pickZone) { %><small><%= partner.pickZone %></small><% } %>
                  </div>
                  <div class="affinity-bar"><i style="width:<%= partner.affinity * 100 %>%"></i></div>
                  <strong class="affinity-value"><%= (partner.affinity * 100).toLocaleString('sv-SE', { maximumFractionDigits: 1 }) %> %</strong>
                  <small class="affinity-orders"><%= partner.commonOrderCount.toLocaleString('sv-SE') %> gemensamma</small>
                  <span class="affinity-open"><%= partner.available ? '›' : '—' %></span>
                <% if (partner.available) { %>
                  </a>
                <% } else { %>
                  </div>
                <% } %>
              <% }) %>
            </div>
          <% } else { %>
            <div class="affinity-empty">Det finns inte tillräckligt många gemensamma order för att visa ett stabilt samband under den valda perioden.</div>
          <% } %>

          <div class="affinity-method"><strong>Så läses måttet:</strong> 42 % betyder att partnerartikeln förekommer på 42 av 100 order som innehåller <%= article.articleNumber %>. Sambandet är riktat och kan därför vara annorlunda från partnerartikelns perspektiv.</div>
        </section>
      </div>
    </main>
  </div>
</body>
</html>
