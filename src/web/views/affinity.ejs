<!DOCTYPE html>
<html lang="sv">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Affinitet — TrendTornado</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/affinity.css"></head>
<body>
  <% const zoneLabel = (zone) => ({ KOLONIAL: 'Kolonial', KYLT: 'Kylt', GRÖNSAKER: 'Grönsaker', FRYS: 'Frys' }[zone] ?? zone); const zoneClass = (zone) => zone.toLowerCase().replace('ö','o'); %>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/"><div class="brand-mark">◉</div><div><div class="brand-name">Trend<span>Tornado</span></div><div class="brand-subtitle">lite hit och lite dit</div></div></a>
      <nav class="sidebar-nav"><a class="nav-item" href="/"><span class="nav-icon">⌂</span>Översikt</a><a class="nav-item" href="/relocations"><span class="nav-icon">⇄</span>Flyttare</a><a class="nav-item" href="/analysis"><span class="nav-icon">◫</span>Analys</a><a class="nav-item active" href="/affinity"><span class="nav-icon">⌁</span>Affinitet</a><a class="nav-item" href="/warehouse"><span class="nav-icon">♙</span>Lagerstruktur</a><a class="nav-item" href="/articles"><span class="nav-icon">▣</span>Artiklar</a><a class="nav-item" href="/settings"><span class="nav-icon">⚙</span>Inställningar</a></nav>
      <div class="latest-analysis"><div class="latest-analysis-title">Senaste analys</div><div><%= period.end.toLocaleDateString('sv-SE') %></div><div class="latest-analysis-meta"><%= importSummary.validHistoryRecords.toLocaleString('sv-SE') %> plockrader</div><div class="analysis-ready"><span class="status-dot"></span>Klar</div></div>
    </aside>
    <main class="main-content affinity-workspace">
      <header class="page-header affinity-header"><div><div class="page-eyebrow">Samband inom plockområdet</div><h1>Affinitet</h1><p>Vilka artiklar plockas tillsammans, ligger långt isär och är viktiga nog att samla?</p></div><div class="date-range"><%= period.start.toISOString().slice(0,10) %><span>–</span><%= period.end.toISOString().slice(0,10) %></div></header>
      <div class="scope-note"><strong>Avdelningsbundna kluster</strong><span>Relationer mellan olika temperatur- och plockområden är exkluderade. En artikel i Frys kan bara bilda kluster med andra artiklar i Frys.</span></div>
      <section class="affinity-summary"><article><span>Analyserade relationer</span><strong><%= model.summary.relations.toLocaleString('sv-SE') %></strong></article><article><span>Operativa kluster</span><strong><%= model.summary.clusters.toLocaleString('sv-SE') %></strong></article><article><span>Hög opportunity</span><strong><%= model.summary.highOpportunity.toLocaleString('sv-SE') %></strong></article><article><span>Avdelningar</span><strong><%= model.summary.departments %></strong></article></section>
      <section class="department-tabs" aria-label="Avdelning"><button class="active" data-zone="">Alla</button><% model.zones.forEach((zone) => { %><button data-zone="<%= zone %>"><%= zoneLabel(zone) %></button><% }) %></section>
      <section class="affinity-filters card"><label>Sök kluster<input id="affinitySearch" type="search" placeholder="Artikelnummer eller namn..."></label><label>Minsta opportunity<select id="opportunityFilter"><option value="0">Alla nivåer</option><option value="0.4">Medel eller högre</option><option value="0.6">Hög eller högre</option><option value="0.8">Mycket hög</option></select></label><label>Minsta spridning<input id="spreadFilter" type="number" min="0" step="10" value="0"><span>meter</span></label></section>
      <section class="cluster-list card"><div class="cluster-list-heading"><div><h2>Prioriterade kluster</h2><p id="clusterResultSummary"></p></div><span>Klicka för att se artiklar och placeringar</span></div><div class="cluster-table-wrap"><table><thead><tr><th>Avdelning</th><th>Kluster</th><th>Artiklar</th><th>Klassprofil</th><th>Förekomst</th><th>Spridning</th><th>Opportunity</th><th></th></tr></thead><tbody><% model.clusters.forEach((cluster) => { %><tr class="cluster-row" tabindex="0" data-id="<%= cluster.id %>" data-zone="<%= cluster.pickZone %>" data-score="<%= cluster.opportunityScore %>" data-spread="<%= cluster.estimatedSpreadMeters %>" data-search="<%= (cluster.name + ' ' + cluster.articleNumbers.join(' ')).toLowerCase() %>"><td><span class="department-badge zone-badge zone-<%= zoneClass(cluster.pickZone) %>"><%= zoneLabel(cluster.pickZone) %></span></td><td><strong><%= cluster.name %></strong><small><%= cluster.priorityReason %></small></td><td><%= cluster.articleNumbers.length %></td><td><%= cluster.classProfile %></td><td><strong><%= cluster.occurrenceCount.toLocaleString('sv-SE') %> order</strong><small><%= cluster.relationCount %> samplockningsrelationer</small></td><td><strong><%= cluster.estimatedSpreadMeters.toLocaleString('sv-SE', { maximumFractionDigits: 0 }) %> m</strong><small><%= (cluster.spread * 100).toFixed(0) %> % av flödet</small></td><td><div class="opportunity"><strong><%= cluster.opportunityScore.toFixed(2).replace('.', ',') %></strong><i><b style="width:<%= Math.min(100,cluster.opportunityScore*100) %>%"></b></i></div></td><td class="open-arrow">›</td></tr><% }) %></tbody></table></div></section>
    </main>
  </div>
  <div id="affinityBackdrop" class="drawer-backdrop" hidden></div><aside id="affinityDrawer" class="affinity-drawer" aria-hidden="true"><button id="closeAffinityDrawer" class="drawer-close" type="button">×</button><div id="affinityDrawerContent"></div></aside>
  <script id="affinityData" type="application/json"><%- JSON.stringify(model.clusters).replace(/</g,'\\u003c') %></script><script src="/js/affinity.js"></script>
</body></html>
