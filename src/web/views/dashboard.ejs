<!DOCTYPE html>
<html lang="sv">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= title %> — Översikt
  </title>

  <link
    rel="stylesheet"
    href="/css/app.css"
  >
</head>


<body>

  <div class="app-shell">


    <!-- ============================================= -->
    <!-- Sidebar                                       -->
    <!-- ============================================= -->

    <aside class="sidebar">

      <a class="brand" href="/" aria-label="TrendTornado – översikt"><img class="brand-logo" src="/assets/trendtornado-logo.png" alt="TrendTornado"></a>


      <nav class="sidebar-nav">

        <a
          class="nav-item active"
          href="/"
        >
          <span class="nav-icon">
            ⌂
          </span>

          Översikt
        </a>


        <div class="nav-group">

          <a
            class="nav-item"
            href="/relocations"
          >
            <span class="nav-icon">
              ⇄
            </span>

            Flyttare

            <span class="nav-chevron">
              ⌃
            </span>
          </a>


          <div class="nav-subitems">

            <a
              class="nav-subitem"
              href="/relocations"
            >
              Alla flyttare
            </a>

            <a
              class="nav-subitem"
              href="/relocations/earlier"
            >
              Flytta tidigare
            </a>

            <a
              class="nav-subitem"
              href="/relocations/later"
            >
              Flytta senare
            </a>

          </div>

        </div>


        <a
          class="nav-item"
          href="/analysis"
        >
          <span class="nav-icon">
            ◫
          </span>

          Analys
        </a>


        <a
          class="nav-item"
          href="/affinity"
        >
          <span class="nav-icon">
            ⌁
          </span>

          Affinitet
        </a>


        <a
          class="nav-item"
          href="/warehouse"
        >
          <span class="nav-icon">
            ♙
          </span>

          Lagerstruktur
        </a>


        <a
          class="nav-item"
          href="/articles"
        >
          <span class="nav-icon">
            ▣
          </span>

          Artiklar
        </a>


        <a
          class="nav-item"
          href="#"
        >
          <span class="nav-icon">
            ◷
          </span>

          Historik
        </a>


        <a
          class="nav-item"
          href="/settings"
        >
          <span class="nav-icon">
            ⚙
          </span>

          Inställningar
        </a>

      </nav>


      <div class="latest-analysis">
        <%- include('partials/analysis-selector', { analysisRuns, activeAnalysis }) %>
      </div>

    </aside>



    <!-- ============================================= -->
    <!-- Main                                          -->
    <!-- ============================================= -->

    <main class="main-content">


      <!-- Header -->

      <header class="page-header">

        <div>

          <h1>
            Översikt
          </h1>

          <p>
            Här är en sammanfattning av ditt lager
            och de mest värdefulla flyttarna.
          </p>

        </div>


        <div class="header-actions">

          <div class="date-range">

            <%= period.start
              .toISOString()
              .slice(0, 10)
            %>

            <span>
              –
            </span>

            <%= period.end
              .toISOString()
              .slice(0, 10)
            %>

            <span class="date-icon">
              □
            </span>

          </div>


          <a class="primary-button" href="/settings#analyses">Hantera analyser <span>→</span></a>

        </div>

      </header>



      <!-- =========================================== -->
      <!-- Dashboard grid                              -->
      <!-- =========================================== -->

      <div class="dashboard-grid">


        <% const dashboardKpis = [
          { label: 'Plockstopp per vecka', value: operationalSummary.stopsPerWeek.toLocaleString('sv-SE', { maximumFractionDigits: 0 }), unit: '', meta: `Genomsnitt över ${operationalSummary.observedWeekCount} veckor`, description: 'Genomsnittligt antal unika artikelstopp per vecka. Måttet beskriver den återkommande arbetsbelastningen i plocket.', icon: '↯', tone: 'green' },
          { label: 'Order per vecka', value: operationalSummary.ordersPerWeek.toLocaleString('sv-SE', { maximumFractionDigits: 0 }), unit: '', meta: `${operationalSummary.stopsPerOrder.toLocaleString('sv-SE', { maximumFractionDigits: 1 })} stopp per order`, description: 'Genomsnittligt antal utleveransorder per vecka. Stopp per order visar hur många olika artiklar en typisk order kräver.', icon: '▤', tone: 'green' },
          { label: 'Flerplocksspann idag', value: (operationalSummary.currentMultiPickSpan * 100).toLocaleString('sv-SE', { maximumFractionDigits: 1 }), unit: '%', meta: 'Genomsnitt för order med flera stopp', description: 'Genomsnittlig sträcka mellan första och sista stoppet inom respektive plockområde, uttryckt som andel av områdets plockflöde. Lägre är bättre.', icon: '↔', tone: 'purple' },
          { label: 'Aktivitet i flyttkandidater', value: (operationalSummary.candidateActivityShare * 100).toLocaleString('sv-SE', { maximumFractionDigits: 1 }), unit: '%', meta: 'Andel av alla plockstopp', description: 'Andel av plockstoppen som hör till artiklar som passerar flyttgränsen. En hög andel betyder att felplacerade artiklar påverkar en stor del av arbetet.', icon: '⇅', tone: 'purple' }
        ]; %>
        <% dashboardKpis.forEach((kpi) => { %>
          <section class="card kpi-card operational-kpi">
            <div class="card-heading"><span><%= kpi.label %></span><span class="info-icon" tabindex="0" role="note" aria-label="<%= kpi.description %>" data-tooltip="<%= kpi.description %>">i</span></div>
            <div class="kpi-content">
              <div><div class="kpi-value"><%= kpi.value %><% if (kpi.unit) { %><small><%= kpi.unit %></small><% } %></div><div class="kpi-meta"><%= kpi.meta %></div></div>
              <div class="kpi-symbol <%= kpi.tone %>"><%= kpi.icon %></div>
            </div>
          </section>
        <% }) %>

        <section class="card zone-workload-card">
          <div class="zone-workload-heading">
            <div><span>Verksamhetsbild</span><h2>Belastning per plockområde</h2><p>Aktivitet och hanterad vikt, inte hur många lagerplatser området råkar innehålla.</p></div>
            <small>Veckosnitt över <%= operationalSummary.observedWeekCount %> veckor</small>
          </div>
          <div class="zone-workload-grid">
            <% pickZones.forEach((zone) => { %>
              <article style="--pick-area-color:<%= zone.color %>">
                <header><span class="pickzone-color has-pick-area-color"></span><strong><%= zone.name %></strong></header>
                <dl>
                  <div><dt>Stopp/vecka</dt><dd><%= zone.stopsPerWeek.toLocaleString('sv-SE', { maximumFractionDigits: 0 }) %></dd></div>
                  <div><dt>Åtgång/vecka</dt><dd><%= zone.quantityPerWeek.toLocaleString('sv-SE', { maximumFractionDigits: 0 }) %></dd></div>
                  <div><dt>Hanterad vikt/vecka</dt><dd><%= zone.handledWeightPerWeek.toLocaleString('sv-SE', { maximumFractionDigits: 0 }) %> kg</dd></div>
                  <div><dt>Kandidataktivitet</dt><dd><%= (zone.candidateActivityShare * 100).toFixed(1) %> %</dd></div>
                </dl>
              </article>
            <% }) %>
          </div>
        </section>



        <!-- ========================================= -->
        <!-- Recommendations table                     -->
        <!-- ========================================= -->

        <section class="card relocation-card">

          <div class="dashboard-packages">
            <div class="dashboard-packages-heading">
              <div>
                <span>Operativa förslag</span>
                <h2>Rekommenderade flyttpaket</h2>
                <p>Välj omfattning och öppna en exakt, ordnad flyttplan. Storlekar inom samma plockområde är alternativa.</p>
              </div>
              <a href="/relocations?workspace=packages#packages">Visa alla flyttpaket →</a>
            </div>
            <% if (packageGroups.length > 0) { %>
              <div class="dashboard-package-zones">
                <% packageGroups.forEach((group) => { %>
                  <article class="dashboard-package-zone" style="--package-color:<%= group.color %>">
                    <header>
                      <span class="badge zone-badge has-pick-area-color" style="--pick-area-color:<%= group.color %>"><%= group.pickZone %></span>
                      <small><%= group.packages.length %> alternativ</small>
                    </header>
                    <div>
                      <% group.packages.forEach((packagePlan) => { %>
                        <a class="dashboard-package-option <%= packagePlan.recommended ? 'recommended' : '' %>" href="/relocations?workspace=packages&amp;zone=<%= encodeURIComponent(group.pickZone) %>&amp;size=<%= packagePlan.size %>#packages">
                          <span><%= packagePlan.sizeLabel %><% if (packagePlan.recommended) { %><b>Rekommenderat</b><% } %></span>
                          <strong><%= packagePlan.steps.length %> flyttar</strong>
                          <small><%= packagePlan.chainCount %> kedj<%= packagePlan.chainCount === 1 ? 'a' : 'or' %> · spann +<%= (packagePlan.spanImprovement * 100).toFixed(2) %> · vikt +<%= (packagePlan.weightOrderImprovement * 100).toFixed(2) %> p.e.</small>
                        </a>
                      <% }) %>
                    </div>
                  </article>
                <% }) %>
              </div>
            <% } else { %>
              <div class="dashboard-package-empty">Skapa en ny analys med algoritmversion 1.8 för att bygga exakta flyttpaket från lediga platser.</div>
            <% } %>
          </div>

          <div class="table-toolbar">

            <div>

              <h2>
                Flyttkandidater
              </h2>

              <p>
                De 50 viktigaste flyttarna, rangordnade efter
                samma prioritetspoäng som i Flyttare.
              </p>

            </div>


            <div class="table-filters">

              <a class="dashboard-all-relocations" href="/relocations">Öppna hela arbetslistan →</a>

              <select id="zoneFilter">

                <option value="">
                  Alla zoner
                </option>

                <% pickZones.forEach(
                  (zone) => {
                %>

                  <option
                    value="<%= zone.name %>"
                  >
                    <%= zone.name %>
                  </option>

                <% }) %>

              </select>


              <select id="directionFilter">

                <option value="">
                  Alla riktningar
                </option>

                <option value="EARLIER">
                  Flytta tidigare
                </option>

                <option value="LATER">
                  Flytta senare
                </option>

              </select>


              <select id="ergonomicFilter">

                <option value="">
                  All ergonomi
                </option>

                <option value="LOW_PREFERRED">
                  Låg föredras
                </option>

                <option
                  value="LOW_STRONGLY_RECOMMENDED"
                >
                  Låg rekommenderas
                </option>

              </select>


              <input
                id="recommendationSearch"
                type="search"
                placeholder="Sök artikelnummer eller namn..."
              >

            </div>

          </div>


          <div class="table-scroll">

            <table class="relocation-table">

              <thead>

                <tr>

                  <th>
                    #
                  </th>

                  <th data-sort="utility" aria-sort="descending" title="Prioritet väger samman aktivitet, gap, flödespåverkan, genomförbarhet, datakvalitet och ergonomi.">
                    Prio
                  </th>

                  <th data-sort="article">
                    Artikel
                  </th>

                  <th>
                    Artikelnamn
                  </th>

                  <th>
                    Plockzon
                  </th>

                  <th>
                    Nuvarande plats
                  </th>

                  <th class="movement-column">
                  </th>

                  <th>
                    Rekommenderad plats
                  </th>

                  <th data-sort="gap">
                    Gap
                  </th>

                  <th>
                    Ergonomi
                  </th>

                  <th>
                  </th>

                </tr>

              </thead>


              <tbody>

                <% recommendations.forEach(
                  (
                    recommendation,
                    index
                  ) => {

                    const gapPositive =
                      recommendation
                        .placementGap >= 0;

                    const zoneClass =
                      (recommendation
                        .pickZone ?? "unknown")
                        .toLowerCase()
                        .replace(
                          "ö",
                          "o"
                        );

                    let ergonomicLabel =
                      "Flexibel höjd";

                    let ergonomicClass =
                      "ergonomic-flexible";

                    if (
                      recommendation
                        .ergonomicRecommendation ===
                      "LOW_PREFERRED"
                    ) {
                      ergonomicLabel =
                        "Låg föredras";

                      ergonomicClass =
                        "ergonomic-low";
                    }

                    if (
                      recommendation
                        .ergonomicRecommendation ===
                      "LOW_STRONGLY_RECOMMENDED"
                    ) {
                      ergonomicLabel =
                        "Låg rekommenderas";

                      ergonomicClass =
                        "ergonomic-strong";
                    }

                %>

                  <tr
                    class="recommendation-row"

                    tabindex="0"

                    role="button"

                    aria-label="Visa analysunderlag för artikel <%= recommendation.articleNumber %>"

                    aria-expanded="false"

                    aria-controls="details-<%= index %>"

                    data-article-number="<%= recommendation.articleNumber %>"

                    data-zone="<%=
                      recommendation.pickZone
                    %>"

                    data-direction="<%=
                      recommendation.direction
                    %>"

                    data-ergonomic="<%=
                      recommendation
                        .ergonomicRecommendation
                    %>"

                    data-utility="<%= recommendation.utility.score %>"

                    data-gap="<%= Math.abs(recommendation.placementGap * 100) %>"

                    data-search="<%=
                      (
                        recommendation
                          .articleNumber +
                        ' ' +
                        recommendation
                          .name
                      ).toLowerCase()
                    %>"
                  >


                    <td class="row-number">

                      <%= index + 1 %>

                    </td>

                    <td>
                      <span class="dashboard-utility-score">
                        <strong><%= recommendation.utility.score %></strong>
                        <small><%= recommendation.utility.label %></small>
                      </span>
                    </td>


                    <td>

                      <strong>
                        <%= recommendation
                          .articleNumber
                        %>
                      </strong>

                    </td>


                    <td>

                      <div class="article-name">

                        <%= recommendation
                          .name
                        %>

                      </div>

                    </td>


                    <td>

                      <span
                        class="
                          badge
                          zone-badge
                          zone-<%= zoneClass %>
                          has-pick-area-color
                        "
                        style="--pick-area-color: <%= pickAreaColors[recommendation.pickZone] ?? '#78827a' %>"
                      >

                        <%= recommendation
                          .pickZone
                        %>

                      </span>

                    </td>


                    <td>

                      <div class="location-main">

                        <%= recommendation
                          .currentZone
                        %>

                        <%= recommendation
                          .currentSection
                        %>

                      </div>


                      <div class="location-sub">

                        Position:

                        <%= (
                          recommendation
                            .currentPosition *
                          100
                        ).toFixed(1) %>

                        %

                      </div>

                    </td>


                    <td class="movement-column">
                      →
                    </td>


                    <td>

                      <div class="location-main">

                        <%= recommendation
                          .recommendedZone
                        %>

                        <%= recommendation
                          .recommendedSection
                        %>

                      </div>


                      <div class="location-sub">

                        Mål:

                        <%= (
                          recommendation
                            .desiredPosition *
                          100
                        ).toFixed(1) %>

                        %

                      </div>

                    </td>


                    <td>

                      <span
                        class="
                          badge
                          gap-badge
                          <%= gapPositive
                            ? 'gap-earlier'
                            : 'gap-later'
                          %>
                        "
                      >

                        <%= gapPositive
                          ? "↑"
                          : "↓"
                        %>

                        <%= Math.abs(
                          recommendation
                            .placementGap *
                          100
                        ).toFixed(1) %>

                        %

                      </span>

                    </td>


                    <td>

                      <span
                        class="
                          badge
                          <%= ergonomicClass %>
                        "
                      >

                        <%= ergonomicLabel %>

                      </span>

                    </td>


                    <td class="details-arrow">
                      ›
                    </td>

                  </tr>


                  <tr
                    id="details-<%= index %>"
                    class="recommendation-detail-row"
                    aria-hidden="true"
                  >

                    <td colspan="11">

                      <div class="inline-details-animation">

                        <div class="inline-details-content">

                          <div class="inline-detail-heading">

                            <span>
                              Underlag för rekommendationen
                            </span>

                            <strong>
                              <%= recommendation.articleNumber %>
                            </strong>

                          </div>


                          <div class="inline-detail-metrics">

                            <div class="inline-detail-metric">
                              <span>Antal stopp</span>
                              <strong><%= recommendation.pickFrequency.toLocaleString("sv-SE") %></strong>
                              <small>unika plockdokument</small>
                            </div>

                            <div class="inline-detail-metric">
                              <span>Plockad mängd</span>
                              <strong><%= recommendation.pickedQuantity.toLocaleString("sv-SE") %></strong>
                              <small>enheter totalt</small>
                            </div>

                            <div class="inline-detail-metric">
                              <span>Mängd per stopp</span>
                              <strong><%= recommendation.averageQuantityPerPick.toLocaleString("sv-SE", { maximumFractionDigits: 2 }) %></strong>
                              <small>enheter i genomsnitt</small>
                            </div>

                            <div class="inline-detail-metric position-metric">
                              <span>Nuvarande position</span>
                              <strong><%= (recommendation.currentPosition * 100).toFixed(1) %> %</strong>
                              <small><%= recommendation.currentZone %> <%= recommendation.currentSection %></small>
                            </div>

                            <div class="inline-position-arrow">
                              →
                            </div>

                            <div class="inline-detail-metric position-metric target">
                              <span>Beräknad position</span>
                              <strong><%= (recommendation.desiredPosition * 100).toFixed(1) %> %</strong>
                              <small><%= recommendation.recommendedZone %> <%= recommendation.recommendedSection %></small>
                            </div>

                            <% if (recommendation.simulatedImpact) { %>
                              <div class="inline-detail-metric impact-metric">
                                <span>Effekt på spann</span>
                                <strong>+<%= (recommendation.simulatedImpact.spanImprovement * 100).toFixed(2) %> p.e.</strong>
                                <small><%= recommendation.simulatedImpact.affectedDocuments.toLocaleString('sv-SE') %> berörda order</small>
                              </div>
                              <div class="inline-detail-metric impact-metric">
                                <span>Effekt på viktordning</span>
                                <strong><%= recommendation.simulatedImpact.weightOrderImprovement >= 0 ? '+' : '' %><%= (recommendation.simulatedImpact.weightOrderImprovement * 100).toFixed(2) %> p.e.</strong>
                                <small>skugganalys</small>
                              </div>
                            <% } %>

                          </div>

                        </div>

                      </div>

                    </td>

                  </tr>

                <% }) %>

              </tbody>

            </table>

          </div>


          <div class="table-footer">

            <span id="tableResultSummary">
            </span>


            <div class="table-pagination">

              <button
                id="previousPage"
                class="pagination-button"
                type="button"
              >
                ‹
              </button>


              <span id="pageIndicator">
              </span>


              <button
                id="nextPage"
                class="pagination-button"
                type="button"
              >
                ›
              </button>

            </div>

          </div>

        </section>



        <!-- ========================================= -->
        <!-- Calendar                                  -->
        <!-- ========================================= -->

        <section class="card calendar-card" hidden>

          <div class="card-heading">

            <span>
              Datatäckning
            </span>

          </div>


          <div class="calendar-header">

            <button id="calendarPrevious" class="ghost-button" type="button" aria-label="Föregående månad">‹</button>

            <strong id="calendarMonthLabel" data-month="<%= calendar.monthKey %>">
              <%= calendar.monthLabel %>
            </strong>

            <button id="calendarNext" class="ghost-button" type="button" aria-label="Nästa månad">›</button>

          </div>


          <div class="calendar-weekdays">

            <span>Mån</span>
            <span>Tis</span>
            <span>Ons</span>
            <span>Tor</span>
            <span>Fre</span>
            <span>Lör</span>
            <span>Sön</span>

          </div>


          <div id="calendarGrid" class="calendar-grid">

            <% calendar.days.forEach(
              (calendarDay) => {
            %>

              <div
                class="
                  calendar-day

                  <%= calendarDay.hasData
                    ? 'has-data'
                    : ''
                  %>

                  <%= calendarDay.outside
                    ? 'outside'
                    : ''
                  %>
                "

                title="<%=
                  calendarDay.recordCount
                %> plockrader"
              >

                <%= calendarDay.day %>

              </div>

            <% }) %>

          </div>


          <div class="calendar-legend">

            <span>

              <i class="legend-dot complete">
              </i>

              Historik finns

            </span>


            <span>

              <i class="legend-dot empty">
              </i>

              Ingen historik

            </span>

          </div>

        </section>



        <!-- ========================================= -->
        <!-- Simulated improvement                     -->
        <!-- ========================================= -->

        <section class="card score-history-card simulation-card" hidden>

          <div class="card-heading">

            <span>
              Simulerad förbättring
            </span>

            <span class="info-icon">
              i
            </span>

          </div>


          <% if (simulation.available) { %>


            <div class="simulation-metrics">


              <!-- Pick span -->

              <div class="simulation-metric">

                <div class="simulation-metric-label">
                  Flerplocks-spann
                </div>


                <div class="simulation-comparison">

                  <span>

                    <%= (
                      simulation
                        .comparison
                        .multiPickSpan
                        .before *
                      100
                    ).toFixed(1) %> %

                  </span>


                  <strong>
                    →
                  </strong>


                  <span class="simulation-after">

                    <%= (
                      simulation
                        .comparison
                        .multiPickSpan
                        .after *
                      100
                    ).toFixed(1) %> %

                  </span>

                </div>


                <div class="simulation-improvement good">

                  ↓

                  <%= (
                    simulation
                      .comparison
                      .multiPickSpan
                      .relativeImprovement *
                    100
                  ).toFixed(1) %>

                  %

                  <span>
                    kortare plockspann
                  </span>

                </div>

              </div>



              <!-- Weight ordering -->

              <div class="simulation-metric">

                <div class="simulation-metric-label">
                  Viktordning
                </div>


                <div class="simulation-comparison">

                  <span>

                    <%= (
                      simulation
                        .comparison
                        .weightOrder
                        .before *
                      100
                    ).toFixed(1) %> %

                  </span>


                  <strong>
                    →
                  </strong>


                  <span class="simulation-after">

                    <%= (
                      simulation
                        .comparison
                        .weightOrder
                        .after *
                      100
                    ).toFixed(1) %> %

                  </span>

                </div>


                <div class="simulation-improvement good">

                  ↑

                  <%= (
                    simulation
                      .comparison
                      .weightOrder
                      .percentagePointImprovement *
                    100
                  ).toFixed(1) %>

                  p.e.

                  <span>
                    bättre viktordning
                  </span>

                </div>

              </div>


            </div>


            <div class="simulation-footer">

              <span>

                <strong>
                  <%= simulation
                    .simulationGroups
                    .toLocaleString(
                      "sv-SE"
                    )
                  %>
                </strong>

                flöden

              </span>


              <span>
                ·
              </span>


              <span>

                <strong>
                  <%= simulation
                    .simulatedPicks
                    .toLocaleString(
                      "sv-SE"
                    )
                  %>
                </strong>

                plock

              </span>


              <span>
                ·
              </span>


              <span>

                <strong>
                  <%= simulation
                    .optimized
                    .comparablePairs
                    .toLocaleString(
                      "sv-SE"
                    )
                  %>
                </strong>

                viktpar

              </span>

            </div>


            <div class="simulation-note">

              Simulerad effekt på samma kompletta
              historiska plockflöden före och efter
              de föreslagna omflyttningarna.

            </div>


          <% } else { %>


            <div class="score-placeholder">

              <p>
                Simuleringen kunde inte beräknas
                för den aktuella analysen.
