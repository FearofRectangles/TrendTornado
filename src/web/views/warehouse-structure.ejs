<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lagerstruktur — TrendTornado</title>
  <link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/warehouse.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/" aria-label="TrendTornado – översikt"><img class="brand-logo" src="/assets/trendtornado-logo.png" alt="TrendTornado"></a>
      <nav class="sidebar-nav">
        <a class="nav-item" href="/"><span class="nav-icon">⌂</span>Översikt</a>
        <div class="nav-group"><a class="nav-item" href="/relocations"><span class="nav-icon">⇄</span>Flyttare<span class="nav-chevron">⌃</span></a><div class="nav-subitems"><a class="nav-subitem" href="/relocations">Alla flyttare</a><a class="nav-subitem" href="/relocations/earlier">Flytta tidigare</a><a class="nav-subitem" href="/relocations/later">Flytta senare</a></div></div>
        <a class="nav-item" href="/analysis"><span class="nav-icon">◫</span>Analys</a>
        <a class="nav-item" href="/affinity"><span class="nav-icon">⌁</span>Affinitet</a>
        <a class="nav-item active" href="/warehouse"><span class="nav-icon">♙</span>Lagerstruktur</a>
        <a class="nav-item" href="/articles"><span class="nav-icon">▣</span>Artiklar</a>
        <a class="nav-item" href="#"><span class="nav-icon">◷</span>Historik</a><a class="nav-item" href="/settings"><span class="nav-icon">⚙</span>Inställningar</a>
      </nav>
      <div class="latest-analysis"><%- include('partials/analysis-selector') %></div>
    </aside>

    <main class="main-content warehouse-workspace">
      <header class="page-header warehouse-header"><div><div class="page-eyebrow">Visuell lagerkarta</div><h1>Lagerstruktur</h1><p>Se flödet, hitta koncentrationer och öppna varje fack ner till hyllnivå.</p></div><div class="layout-toggle" title="Exakt optimerad slotplacering byggs i en kommande version"><button class="active" type="button">Nu</button><button type="button" disabled>Optimerat</button></div></header>

      <section class="warehouse-summary"><div><strong><%= model.summary.pickZones %></strong><span>plockzoner</span></div><div><strong><%= model.summary.physicalZones %></strong><span>fysiska zoner</span></div><div><strong><%= model.summary.bays.toLocaleString('sv-SE') %></strong><span>fack</span></div><div><strong><%= model.summary.pickLocations.toLocaleString('sv-SE') %></strong><span>plockplatser</span></div><div><strong><%= model.summary.dimensionedLocations.toLocaleString('sv-SE') %></strong><span>måttsatta platser</span></div><div><strong><%= model.summary.placedArticles.toLocaleString('sv-SE') %></strong><span>placerade artiklar</span></div></section>

      <div id="pickZoneTabs" class="pick-zone-tabs" role="tablist"><% model.pickZones.forEach((pickZone, index) => { %><button type="button" role="tab" data-pick-zone="<%= pickZone.name %>" aria-selected="<%= index === 0 %>"><%= pickZone.name %><small><%= pickZone.zones.length %> zoner</small></button><% }) %></div>

      <section class="warehouse-map-card card">
        <div class="map-toolbar"><div><span class="flow-label">Plockriktning <b>→</b></span><p>Varje ruta motsvarar ett fack. Starkare färg betyder högre värde.</p></div><fieldset id="colorMode"><legend>Färg efter</legend><label><input type="radio" name="color" value="priority" checked><i></i>Prioritet</label><label><input type="radio" name="color" value="frequency"><i></i>Plockfrekvens</label><label><input type="radio" name="color" value="weight"><i></i>Vikt</label><label><input type="radio" name="color" value="gap"><i></i>Placement gap</label></fieldset></div>
        <div class="heat-scale"><span>Lågt</span><i></i><i></i><i></i><i></i><i></i><span>Högt</span><b>Tomt fack</b></div>
        <div id="warehouseMap" class="warehouse-map"></div>
      </section>

      <section id="zoneDrilldown" class="zone-drilldown card" hidden>
        <div class="drilldown-heading"><div><span>Vald zon</span><h2 id="selectedZoneTitle"></h2><p id="selectedZoneMeta"></p></div><button id="closeZoneDrilldown" type="button">Stäng detaljvy ×</button></div>
        <div id="bayGrid" class="bay-grid"></div>
      </section>

      <section id="bayDrilldown" class="bay-drilldown card" hidden>
        <div class="drilldown-heading"><div><span>Fack</span><h2 id="selectedBayTitle"></h2><p id="selectedBayMeta"></p></div><button id="closeBayDrilldown" type="button">Stäng ×</button></div>
        <div id="shelfStack" class="shelf-stack"></div>
      </section>
    </main>
  </div>
  <script id="warehouseData" type="application/json"><%- JSON.stringify(model).replace(/</g, "\\u003c") %></script>
  <script src="/js/warehouse.js"></script>
</body>
</html>
