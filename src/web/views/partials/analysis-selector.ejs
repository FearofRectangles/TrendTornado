<% if (activeAnalysis) { %>
  <div class="latest-analysis-title">Aktiv analys</div>
  <form class="analysis-selector" method="post" action="/analyses/activate">
    <select name="analysisId" aria-label="Välj aktiv analys" onchange="this.form.submit()">
      <% analysisRuns.filter((run) => run.status === 'COMPLETED').forEach((run) => { %>
        <option value="<%= run.id %>" <%= run.isActive ? 'selected' : '' %>><%= run.name %></option>
      <% }) %>
    </select>
  </form>
  <div class="latest-analysis-meta"><%= activeAnalysis.periodStart %> – <%= activeAnalysis.periodEnd %></div>
  <div class="latest-analysis-meta"><%= activeAnalysis.inputRows.toLocaleString('sv-SE') %> plockrader</div>
  <div class="analysis-ready"><span class="status-dot"></span>Klar</div>
<% } else { %>
  <div class="latest-analysis-title">Startläge</div>
  <div class="latest-analysis-meta">Ingen aktiv analys</div>
  <div class="analysis-ready pending"><span class="status-dot"></span>Konfigurera under Inställningar</div>
<% } %>
